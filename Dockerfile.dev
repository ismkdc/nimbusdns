# =============================================================================
# NimbusDNS — Development Container
# =============================================================================
# Latest stable Rust with all system dependencies for building and debugging.
# Everything stays inside the container — no host tooling needed.

FROM docker.io/rust:1-bookworm

# Install build deps and useful tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libsqlite3-dev \
    libssl-dev \
    lua5.4-dev \
    liblua5.4-dev \
    cmake \
    net-tools \
    iputils-ping \
    dnsutils \
    curl \
    vim \
    strace \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy manifests first for better caching
COPY Cargo.toml Cargo.lock* ./
COPY nimbus-core/Cargo.toml nimbus-core/
COPY nimbus-api/Cargo.toml nimbus-api/
COPY nimbus-web/Cargo.toml nimbus-web/
COPY nimbus-bin/Cargo.toml nimbus-bin/

# Create src directories and stub files so cargo can resolve
RUN mkdir -p nimbus-core/src nimbus-api/src nimbus-web/src nimbus-bin/src \
    && touch nimbus-core/src/lib.rs nimbus-api/src/lib.rs nimbus-web/src/lib.rs nimbus-bin/src/main.rs

# Build dependencies (cached layer)
RUN cargo build --release 2>/dev/null || true

# Copy actual source
COPY . .

# Build the full project
RUN cargo build --release 2>&1 || cargo build 2>&1 || true

# Generate shell config for aliases
RUN echo 'alias ll="ls -la"' >> ~/.bashrc \
    && echo 'alias c="cargo"' >> ~/.bashrc \
    && echo 'alias cr="cargo run --bin nimbusdns -- -f"' >> ~/.bashrc \
    && echo 'alias cb="cargo build"' >> ~/.bashrc \
    && echo 'alias ck="cargo check"' >> ~/.bashrc

CMD ["/bin/bash", "-c", "echo 'NimbusDNS Dev Container Ready'; echo 'Run: cargo build --release --bin nimbusdns'; sleep infinity"]
